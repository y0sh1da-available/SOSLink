// SOSLink — Database schema (PostgreSQL + PostGIS)
// To view: paste this file into https://dbdiagram.io
// Conventions: uuid primary keys, timestamptz times (UTC).

Project SOSLink {
  database_type: 'PostgreSQL'
  Note: 'Flood rescue request coordination — TARGET V1'
}

// ============================================================ Enums

Enum user_role {
  VOLUNTEER
  COORDINATOR
  TEAM
  ADMIN
}

Enum user_status {
  INVITED
  ACTIVE
  DISABLED
}

Enum event_status {
  OPEN
  CLOSED
}

Enum report_channel {
  PUBLIC_FORM
  VOLUNTEER_PASTE
  ZALO_OA
}

Enum ai_status {
  PENDING
  OK
  FAILED
  TIMEOUT
}

Enum case_status {
  NEW
  TRIAGED
  ASSIGNED
  EN_ROUTE
  RESOLVED
  INVALID
  MERGED
}

Enum priority {
  P1
  P2
  P3
  P4
}

Enum verification_status {
  UNVERIFIED
  REACHED
  UNREACHABLE
}

Enum location_source {
  GPS
  GEOCODED
  MANUAL_PIN
  NONE
}

Enum merge_suggestion_status {
  PENDING
  ACCEPTED
  REJECTED
}

Enum assignment_status {
  OFFERED
  ACCEPTED
  DECLINED
  TIMED_OUT
  EN_ROUTE
  COMPLETED
  CANCELLED
}

Enum assignment_outcome {
  RESCUED
  HANDLED_BY_OTHERS
  CANNOT_REACH
  NOT_FOUND
}

Enum team_status {
  AVAILABLE
  BUSY
  OFF_DUTY
}

Enum vehicle_type {
  BOAT
  CAR
  ON_FOOT
  OTHER
}

Enum alert_type {
  SLA_NOT_ASSIGNED
  TEAM_NOT_ACCEPTED
  TEAM_NO_UPDATE
  TEAM_CANNOT_REACH
  NEW_INFO_ON_ACTIVE_CASE
}

// ============================================================ Accounts & configuration

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [note: 'null until activated']
  full_name varchar(120) [note: 'null until activated; the invited person enters it at SCR-05']
  phone varchar(20)
  role user_role [not null]
  status user_status [not null, default: 'INVITED']
  team_id uuid [ref: > teams.id, note: 'Required when role = TEAM']
  failed_login_count int [not null, default: 0]
  locked_until timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'No hard delete; only DISABLED.'
}

Table invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar(128) [not null, unique, note: 'SHA-256, the original token is not stored']
  expires_at timestamptz [not null, note: '7 days']
  used_at timestamptz
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table disaster_events {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(120) [not null]
  area_description text
  status event_status [not null, default: 'OPEN']
  sla_p1_minutes int [not null, default: 10]
  sla_p2_minutes int [not null, default: 30]
  sla_p3_minutes int [not null, default: 120]
  team_accept_minutes int [not null, default: 5]
  team_update_minutes int [not null, default: 30]
  opened_at timestamptz [not null, default: `now()`]
  closed_at timestamptz
  anonymized_at timestamptz [note: 'Anonymised 90 days after closed_at']
  lessons_learned text [note: 'Lessons learned in the after-action report (SCR-41)']
  created_by uuid [not null, ref: > users.id]
}

Table danger_keywords {
  id uuid [pk, default: `gen_random_uuid()`]
  keyword varchar(80) [not null, unique, note: 'Matched after removing diacritics; only used to raise the level']
  minimum_priority priority [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

// ============================================================ Intake

Table reports {
  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null, ref: > disaster_events.id]
  case_id uuid [ref: > cases.id, note: 'Case the message belongs to; changes on merge or undo']
  channel report_channel [not null]
  raw_text text [note: 'Original message: never edited or deleted before anonymisation']
  source_url text
  contact_phone varchar(20)
  gps_lat numeric(9,6)
  gps_lng numeric(9,6)
  form_people_count int
  form_vulnerable jsonb [note: 'Options the sender tapped on the form']
  tracking_code varchar(12) [unique, note: 'Public tracking code, random, cannot be guessed']
  submitted_by uuid [ref: > users.id, note: 'null = sent directly by a resident']
  idempotency_key uuid [unique, note: 'Prevents duplicate sends on an unstable network']
  ip_hash varchar(128) [note: 'Rate limiting; the original IP is not stored']
  ai_status ai_status [not null, default: 'PENDING']
  received_at timestamptz [not null, default: `now()`]

  indexes {
    (event_id, received_at)
    case_id
    contact_phone
  }

  Note: 'Saved before any AI processing (BR01).'
}

Table report_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  storage_key text [not null]
  mime_type varchar(30) [not null]
  size_bytes int [not null, note: '≤ 5 MB']
  created_at timestamptz [not null, default: `now()`]
}

Table ai_extractions {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null, ref: > reports.id]
  model varchar(60) [not null]
  prompt_version varchar(20) [not null]
  status ai_status [not null]
  output jsonb [note: 'Raw result per schema; see 02-scope.md section 5']
  is_rescue_request boolean
  suggested_priority priority
  confidence numeric(3,2)
  possibly_old boolean [not null, default: false]
  latency_ms int
  input_tokens int
  output_tokens int
  attempt smallint [not null, default: 1]
  error text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, created_at)
  }
}

// ============================================================ Ca

Table cases {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(12) [not null, unique, note: 'VD: #1042']
  event_id uuid [not null, ref: > disaster_events.id]
  status case_status [not null, default: 'NEW']
  priority priority [not null]
  priority_reason text
  matched_keywords jsonb [note: 'Danger keywords matched in the message, shown next to the priority reason (BR04)']
  needs_human_read boolean [not null, default: false, note: 'AI failed or low confidence']
  verification verification_status [not null, default: 'UNVERIFIED']
  summary text
  address_text text
  commune_id uuid [ref: > admin_units.id]
  location_source location_source [not null, default: 'NONE']
  location_confidence numeric(3,2)
  lat numeric(9,6)
  lng numeric(9,6)
  phones jsonb
  people_count int
  vulnerable jsonb [note: 'ELDERLY, INFANT, CHILD, PREGNANT, INJURED, DISABLED']
  needs jsonb
  people_rescued int
  merged_into_id uuid [ref: > cases.id, note: 'Khi status = MERGED']
  invalid_reason text
  sla_due_at timestamptz [note: 'Assignment deadline by priority']
  reviewed_by uuid [ref: > users.id]
  reviewed_at timestamptz
  resolved_at timestamptz
  version int [not null, default: 0, note: 'Optimistic lock against duplicate assignment']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (event_id, status, priority, created_at) [note: 'Queue']
    (status, sla_due_at) [note: 'Overdue alert job']
    (lat, lng) [note: 'Can be replaced by GiST on a PostGIS geography column']
  }
}

Table case_field_corrections {
  id uuid [pk, default: `gen_random_uuid()`]
  case_id uuid [not null, ref: > cases.id]
  field varchar(40) [not null, note: 'address, phones, people_count, priority…']
  ai_value jsonb
  final_value jsonb
  corrected_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Data source for measuring AI quality (US20).'
}

Table merge_suggestions {
  id uuid [pk, default: `gen_random_uuid()`]
  case_id uuid [not null, ref: > cases.id]
  candidate_case_id uuid [not null, ref: > cases.id]
  reason varchar(120) [not null, note: 'Same phone; N m apart with similar content']
  score numeric(3,2)
  status merge_suggestion_status [not null, default: 'PENDING']
  decided_by uuid [ref: > users.id]
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (case_id, candidate_case_id) [unique]
  }
}

Table verification_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  case_id uuid [not null, ref: > cases.id]
  result verification_status [not null]
  note text
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table case_events {
  id bigserial [pk]
  case_id uuid [not null, ref: > cases.id]
  type varchar(40) [not null, note: 'CREATED, PRIORITY_CHANGED, MERGED, ASSIGNED, TEAM_UPDATE…']
  from_value jsonb
  to_value jsonb
  note text
  actor_id uuid [ref: > users.id, note: 'null = SYSTEM']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (case_id, created_at)
  }

  Note: 'Case timeline; append only.'
}

Table admin_units {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(10) [not null, unique]
  name varchar(120) [not null]
  level varchar(10) [not null, note: 'PROVINCE | COMMUNE']
  parent_id uuid [ref: > admin_units.id]

  Note: 'List after the 2025 merger (two levels).'
}

// ============================================================ Teams & assignment

Table teams {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(80) [not null, unique]
  phone varchar(20) [not null]
  vehicle vehicle_type [not null]
  capacity int [note: 'Number of people it can carry']
  area_description text [note: 'Operating area (SCR-52)']
  status team_status [not null, default: 'AVAILABLE']
  last_lat numeric(9,6)
  last_lng numeric(9,6)
  last_seen_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  case_id uuid [not null, ref: > cases.id]
  team_id uuid [not null, ref: > teams.id]
  status assignment_status [not null, default: 'OFFERED']
  outcome assignment_outcome
  people_rescued int
  decline_reason text
  note text
  assigned_by uuid [not null, ref: > users.id]
  accept_due_at timestamptz [not null]
  accepted_at timestamptz
  last_update_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (team_id, status)
    (status, accept_due_at)
    case_id
  }

  Note: 'A case has at most one active assignment (partial unique index on case_id).'
}

Table team_updates {
  id uuid [pk, default: `gen_random_uuid()`]
  assignment_id uuid [not null, ref: > assignments.id]
  client_update_id uuid [not null, unique, note: 'Resending after losing network creates no duplicate record']
  kind varchar(20) [not null, note: 'EN_ROUTE, OUTCOME, NOTE']
  payload jsonb
  entered_by uuid [not null, ref: > users.id, note: 'Team leader, or a coordinator updating on their behalf']
  occurred_at timestamptz [not null, note: 'Time on the device']
  received_at timestamptz [not null, default: `now()`]
}

// ============================================================ Alerts, audit, jobs

Table alerts {
  id uuid [pk, default: `gen_random_uuid()`]
  case_id uuid [not null, ref: > cases.id]
  assignment_id uuid [ref: > assignments.id]
  type alert_type [not null]
  acknowledged_by uuid [ref: > users.id]
  acknowledged_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (case_id, type) [note: 'Partial unique while unacknowledged: no repeat alerts']
    acknowledged_at
  }
}

Table audit_logs {
  id bigserial [pk]
  actor_id uuid [ref: > users.id]
  action varchar(60) [not null, note: 'VIEW_PHONE, EXPORT, LOGIN_FAILED, USER_DISABLED…']
  entity_type varchar(40) [not null]
  entity_id uuid
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
    (actor_id, created_at)
  }
}

Table job_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  job varchar(40) [not null, note: 'SLA_CHECK, AI_RETRY, ANONYMIZE']
  status varchar(20) [not null]
  processed_count int [not null, default: 0]
  error text
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
}
